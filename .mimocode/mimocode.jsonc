{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "loveflow": {
      "name": "LoveFlow",
      "api": "http://127.0.0.1:1234/v1",
      "models": {
        "negentropy-claude-opus-4.7-9b": {
          "name": "Negentropy Claude Opus 4.7 9B",
          "limit": {
            "context": 8192,
            "output": 4096
          },
          "cost": {
            "input": 0,
            "output": 0,
            "cache_read": 0,
            "cache_write": 0
          },
          "temperature": true,
          "reasoning": false,
          "tool_call": true,
          "attachment": false,
          "modalities": {
            "input": ["text"],
            "output": ["text"]
          }
        }
      }
    }
  },
  "model": "loveflow/negentropy-claude-opus-4.7-9b",
  "disabled_providers": [
    "mimo", "opencode", "anthropic", "openai", "google",
    "github-copilot", "amazon-bedrock", "openrouter",
    "xai", "mistral", "groq", "deepinfra", "cerebras",
    "cohere", "togetherai", "perplexity", "alibaba",
    "gitlab", "cloudflare-workers-ai", "deepseek"
  ]
}
